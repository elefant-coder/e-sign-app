# アプリの公開 URL（署名依頼メールのリンクに使う）
NEXT_PUBLIC_APP_URL=https://your-domain.example
# 自社名（署名依頼メール・署名画面・締結済み PDF に出る）
NEXT_PUBLIC_COMPANY_NAME=株式会社〇〇

# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# メール送信（Resend）
RESEND_API_KEY=
FROM_EMAIL=電子署名 <no-reply@your-domain.example>
# 締結完了の通知を受け取る自社のメールアドレス
ADMIN_EMAIL=

# 管理画面の Basic 認証
BASIC_AUTH_USER=
# 必須。未設定だと管理画面と管理 API は 503 で止まる（安全のため通さない）
BASIC_AUTH_PASSWORD=
